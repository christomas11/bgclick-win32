# 虚拟环境（含 build/dist 产物，不入库）
env/
.venv/
venv/

# Python 缓存
__pycache__/
*.py[cod]

# PyInstaller 产物（build/ 是中间垃圾，dist/ 是打包结果，都不入库）
build/
dist/
*.manifest

# 截图产物
shots/

# IDE / 工程缓存
.vs/
.idea/
*.user

# 运行时状态与日志（正常状态目录在 %USERPROFILE%\.bgclick，这里兜底）
.bgstate/
*.log

# 打包与测试产物
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# PyInstaller 输出目录（dist/ 与 build/ 已在上面，这里补新旧两套命名）
dist_new/
build_new/
